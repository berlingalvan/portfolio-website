---
import site from '../data/site.json';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  active?: 'home' | 'blog' | 'about';
}
const { title = site.title, description = site.description, active } = Astro.props;
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={site.name} href={`${base}/rss.xml`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {
      site.goatcounter && (
        <Fragment
          set:html={`<script data-goatcounter="https://${site.goatcounter}.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>`}
        />
      )
    }
  </head>
  <body>
    <div class="wrap">
      <header class="site">
        <div class="navbar">
          <a class="wordmark" href={`${base}/`}><span class="star">✦</span> {site.name}</a>
          <nav class="pages" aria-label="Site pages">
            <a href={`${base}/`} class={active === 'home' ? 'active' : ''}>Home</a>
            <a href={`${base}/blog/`} class={active === 'blog' ? 'active' : ''}>Blog</a>
            <a href={`${base}/about/`} class={active === 'about' ? 'active' : ''}>About</a>
          </nav>
        </div>
        <hr class="rainbow-rule" />
      </header>

      <main>
        <slot />
      </main>

      <footer class="site">
        <span><span class="star">✦</span> {site.name} · {year}</span>
        <span class="flinks">
          <a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
          <a href={site.github} target="_blank" rel="noopener">GitHub</a>
          <a href={`${base}/rss.xml`}>RSS</a>
        </span>
      </footer>
    </div>
  </body>
</html>
