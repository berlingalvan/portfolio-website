---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import site from '../../data/site.json';

const base = import.meta.env.BASE_URL;
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const fmt = (d: Date) => d.toISOString().slice(0, 10);
---
<Base active="blog" title={`Blog — ${site.name}`}>
  <h1 class="page-title">Blog</h1>
  <p class="page-sub">
    Working notes on recommendation systems, retrieval, and computer vision. Mostly things I wish
    someone had written down before I needed them.
  </p>

  {posts.map((post) => (
    <article class="post">
      <time datetime={fmt(post.data.pubDate)}>{fmt(post.data.pubDate)}</time>
      <div class="body">
        <h3><a class="postlink" href={`${base}/blog/${post.id}/`}>{post.data.title}</a></h3>
        <p>{post.data.description}</p>
      </div>
    </article>
  ))}
</Base>
